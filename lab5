                        const SizedBox(height: 10),
                        const Text(
                          "Experience the finest quality chocolate crafted by AO «Bayan Sulu». This premium assortment delivers a rich, authentic taste that represents decades of confectionery excellence. Perfect for gifting or personal enjoyment.",
