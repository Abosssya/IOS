// Task 2
void main() {
  var d1 = "31.12.2025"; 
  var d2 = "28.02.2025"; 
  var d3 = "28.02.2024"; 
  var d4 = "28.02.2100"; 

  List<String> dates = [d1, d2, d3, d4];

  for (String date in dates) {
    var parts = date.split('.');
    int day = int.parse(parts[0]);
    int month = int.parse(parts[1]);
    int year = int.parse(parts[2]);

    int maxDays = 31; 
    
    if (month == 4 || month == 6 || month == 9 || month == 11) {
      maxDays = 30;
    } else if (month == 2) {
      bool isLeapYear = (year % 4 == 0 && year % 100 != 0) || (year % 400 == 0);
      if (isLeapYear) {
        maxDays = 29;
      } else {
        maxDays = 28;
      }
    }

    day++;

    if (day > maxDays) {
      day = 1;
      month++;
      
      if (month > 12) {
        month = 1;
        year++;
      }
    }

    String nextDay = day.toString().padLeft(2, '0');
    String nextMonth = month.toString().padLeft(2, '0');

    print('$date -> $nextDay.$nextMonth.$year');
  }
}

// Task 3
void main() {
  String text  = 'flutter mobile development';
  int vowelCount = 0;
  String textlower = text.toLowerCase();
  
  for (int i=0; i<textlower.length;i++) {
    String char = textlower[i];
    if (char == 'a' || char == 'e' || char == 'i' || char == 'o' || char == 'u') {
      vowelCount++;
    }
  }
  print('"$text" -> $vowelCount');
}

// Task 4
void main() {
  List<int> numbers = [14, 88, 3, 42, 99, 12, 67];
  
  int min = numbers[0];
  int max = numbers[0];
  
  for (int i = 0;i<numbers.length;i++) {
    if (numbers[i]>max) {
      max = numbers[i];
    }
    if (numbers[i]< min) {
      min = numbers[i];
    }
  }
  print('List $numbers -> max: $max, min: $min');
}

